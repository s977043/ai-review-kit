{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Evolution Cycle Shadow Aggregate Schema",
  "description": "Read-only aggregate over completed review runs and captured feedback (#1574 P1). Emitted by `river evolve aggregate`. The artifact is an observation only: it never mutates Skills, rules, Riverbed, the gate, or a PR. Trust levels and the acceptance gate follow contract 1 of docs/development/1574-p0-design-contract.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "mode",
    "readOnly",
    "policyVersion",
    "collectorVersion",
    "inputs",
    "evidence",
    "join",
    "clusters",
    "candidate"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidenceSource": {
      "type": "string",
      "description": "Contract 1 evidence provenance, as CLAIMED by the run record. The record lives in `.river/runs/` inside the reviewed repository and is writable by the agent under review, so this value is self-reported and unverified — it never raises trust in P1.",
      "enum": ["local", "CI", "protected-branch", "human"]
    },
    "trustLevel": {
      "type": "string",
      "description": "P1 emits `untrusted` for every record: provenance is self-reported and there is no verification mechanism yet. The promotion path (verified `trusted_by`) is a contract 1 未決事項 handled in P2.",
      "const": "untrusted"
    },
    "runEvidence": {
      "type": "object",
      "description": "Contract 1 provenance record for one saved run. Every field is self-reported by the reviewed repository and unverified.",
      "required": [
        "review_run_id",
        "evidence_source",
        "source_commit_sha",
        "artifact_sha256",
        "collector_version",
        "trusted_by",
        "generated_by_candidate",
        "provenance_verified",
        "trust_level"
      ],
      "additionalProperties": false,
      "properties": {
        "review_run_id": {
          "type": ["string", "null"],
          "description": "Canonical review run id (contract 2). Self-reported: two records can claim the same id, which is reported via join.duplicateReviewRunIds."
        },
        "evidence_source": { "$ref": "#/$defs/evidenceSource" },
        "source_commit_sha": { "type": ["string", "null"] },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SELF-DIGEST of the same record it is stored on. Detects accidental drift between copies; it does NOT prove authenticity, because whoever can edit the record can recompute it."
        },
        "collector_version": { "type": "string" },
        "trusted_by": {
          "type": ["string", "null"],
          "description": "Claimed verifier. Unverified in P1 and therefore not a trust input."
        },
        "generated_by_candidate": { "type": "boolean" },
        "provenance_verified": {
          "type": "boolean",
          "const": false,
          "description": "Always false in P1: no verification mechanism for the claimed provenance exists yet."
        },
        "trust_level": { "$ref": "#/$defs/trustLevel" }
      }
    },
    "feedbackRef": {
      "type": "object",
      "required": ["review_run_id", "timestamp", "feedbackType", "findingFingerprint", "pr"],
      "additionalProperties": false,
      "properties": {
        "review_run_id": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] },
        "feedbackType": { "type": ["string", "null"] },
        "findingFingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "pr": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "subCluster": {
      "type": "object",
      "description": "Contract 5 stage 2: a recurring class split into a cause hypothesis by fingerprint / category / scope. `failureMode` stays null in P1 because its vocabulary is decided after shadow observation.",
      "required": [
        "subClusterKey",
        "fingerprint",
        "category",
        "scope",
        "failureMode",
        "count",
        "distinctFindingCount",
        "distinctPrCount",
        "distinctRunCount",
        "distinctOccurrenceCount",
        "experimentEligible",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "subClusterKey": { "type": "string" },
        "fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "category": {
          "type": ["string", "null"],
          "description": "finding.category, falling back to finding.ruleId (the emitting skill id). Null when the fingerprint resolves to no saved finding."
        },
        "scope": { "type": ["string", "null"] },
        "failureMode": { "type": ["string", "null"] },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Raw feedback row count. Not recurrence evidence on its own — several rows can describe one re-litigated finding."
        },
        "distinctFindingCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "distinctPrCount": { "type": "integer", "minimum": 0 },
        "distinctRunCount": { "type": "integer", "minimum": 0 },
        "distinctOccurrenceCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct (review_run_id, pr) pairs. Rows attributable to neither are excluded."
        },
        "experimentEligible": {
          "type": "boolean",
          "description": "True only when the sub-cluster has a finding fingerprint AND at least minRecurrence distinct occurrences. Everything else is displayed but must never feed an automatic experiment or promotion (contract 5)."
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/feedbackRef" } }
      }
    },
    "cluster": {
      "type": "object",
      "description": "Contract 5 stage 1: recurrence detection on (skillId, feedbackType).",
      "required": [
        "clusterKey",
        "skillId",
        "feedbackType",
        "count",
        "distinctFindingCount",
        "distinctPrCount",
        "subClusters"
      ],
      "additionalProperties": false,
      "properties": {
        "clusterKey": { "type": "string", "pattern": "^.+::.+$" },
        "skillId": { "type": "string" },
        "feedbackType": { "type": "string" },
        "count": { "type": "integer", "minimum": 1, "description": "Raw feedback row count." },
        "distinctFindingCount": { "type": "integer", "minimum": 0 },
        "distinctPrCount": { "type": "integer", "minimum": 0 },
        "subClusters": { "type": "array", "items": { "$ref": "#/$defs/subCluster" } }
      }
    },
    "candidate": {
      "type": "object",
      "description": "ReviewImprovementCandidate in shadow mode. One candidate = one hypothesis; P1 records the observation and leaves the hypothesis and every write to a human.",
      "required": [
        "schemaVersion",
        "candidateId",
        "contentHash",
        "uniqueEvidenceCount",
        "policyVersion",
        "createdAt",
        "mode",
        "status",
        "clusterKey",
        "subClusterKey",
        "skillId",
        "feedbackType",
        "observedPattern",
        "causeHypothesis",
        "targetSurface",
        "candidateType",
        "failureMode",
        "recurrenceCount",
        "subClusterCount",
        "distinctFindingCount",
        "distinctPrCount",
        "distinctRunCount",
        "distinctOccurrenceCount",
        "sourceReviewRunIds",
        "sourceFeedbackRefs",
        "evidence",
        "trust",
        "experimentEligible",
        "requiresHumanApproval",
        "autoActions",
        "writeEffects"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "candidateId": {
          "type": "string",
          "pattern": "^RR-PC-[0-9a-f]{12}$",
          "description": "Content-addressed id from src/lib/promotion-candidates.mjs (contract 4): sha256 over { clusterKey, normalized evidence, policyVersion }, never the generation date. Identical to the id `river promote propose` mints for the same evidence, so shadow observation and persisted candidate converge."
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Full hash behind candidateId, so a reader can re-derive and verify the 12-hex truncation."
        },
        "uniqueEvidenceCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Evidence items after deduplication / NFC normalization — the set the hash was computed over."
        },
        "policyVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mode": { "type": "string", "const": "shadow" },
        "status": { "type": "string", "const": "observed" },
        "clusterKey": { "type": "string" },
        "subClusterKey": { "type": "string" },
        "skillId": { "type": "string" },
        "feedbackType": { "type": "string" },
        "observedPattern": { "type": "string" },
        "causeHypothesis": { "type": ["string", "null"] },
        "targetSurface": {
          "type": ["string", "null"],
          "enum": [
            "routing",
            "context",
            "judgment",
            "reviewer",
            "memory",
            "evaluation",
            "execution",
            null
          ]
        },
        "candidateType": {
          "type": "string",
          "enum": ["experiment_candidate", "observation_only"]
        },
        "failureMode": { "type": ["string", "null"] },
        "recurrenceCount": { "type": "integer", "minimum": 1 },
        "subClusterCount": { "type": "integer", "minimum": 1 },
        "distinctFindingCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "distinctPrCount": { "type": "integer", "minimum": 0 },
        "distinctRunCount": { "type": "integer", "minimum": 0 },
        "distinctOccurrenceCount": { "type": "integer", "minimum": 0 },
        "sourceReviewRunIds": { "type": "array", "items": { "type": "string" } },
        "sourceFeedbackRefs": { "type": "array", "items": { "$ref": "#/$defs/feedbackRef" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/runEvidence" } },
        "trust": {
          "type": "object",
          "required": [
            "trustedEvidenceCount",
            "untrustedEvidenceCount",
            "unjoinedEvidenceCount",
            "canaryEligible",
            "reasons"
          ],
          "additionalProperties": false,
          "properties": {
            "trustedEvidenceCount": {
              "type": "integer",
              "const": 0,
              "description": "Always 0 in P1 — no evidence path can reach `trusted` (see trustLevel)."
            },
            "untrustedEvidenceCount": { "type": "integer", "minimum": 0 },
            "unjoinedEvidenceCount": { "type": "integer", "minimum": 0 },
            "canaryEligible": {
              "type": "boolean",
              "const": false,
              "description": "Acceptance gate (contract 1). Always false in P1: candidate adoption requires trusted evidence produced outside the candidate's own write scope, which lands in P2 and later."
            },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "experimentEligible": { "type": "boolean" },
        "requiresHumanApproval": { "type": "boolean", "const": true },
        "autoActions": {
          "type": "array",
          "items": { "type": "string", "enum": ["observe"] }
        },
        "writeEffects": {
          "type": "array",
          "maxItems": 0,
          "description": "Machine-checkable assertion that the shadow aggregate performs no writes."
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "const": "shadow" },
    "readOnly": { "type": "boolean", "const": true },
    "policyVersion": { "type": "string" },
    "collectorVersion": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["runCount", "feedbackCount", "minRecurrence", "month"],
      "additionalProperties": false,
      "properties": {
        "runCount": { "type": "integer", "minimum": 0 },
        "feedbackCount": { "type": "integer", "minimum": 0 },
        "minRecurrence": { "type": "integer", "minimum": 1 },
        "month": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["runs", "trustedRunCount", "untrustedRunCount"],
      "additionalProperties": false,
      "properties": {
        "runs": { "type": "array", "items": { "$ref": "#/$defs/runEvidence" } },
        "trustedRunCount": {
          "type": "integer",
          "const": 0,
          "description": "Always 0 in P1 — see trustLevel."
        },
        "untrustedRunCount": { "type": "integer", "minimum": 0 }
      }
    },
    "join": {
      "type": "object",
      "description": "Contract 2 propagation coverage: how much feedback can be traced back to a saved run through the canonical review_run_id.",
      "required": [
        "joinedFeedbackCount",
        "unjoinedFeedbackCount",
        "runIdsWithEvidence",
        "duplicateReviewRunIds"
      ],
      "additionalProperties": false,
      "properties": {
        "joinedFeedbackCount": { "type": "integer", "minimum": 0 },
        "unjoinedFeedbackCount": { "type": "integer", "minimum": 0 },
        "runIdsWithEvidence": { "type": "array", "items": { "type": "string" } },
        "duplicateReviewRunIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "review_run_id values claimed by more than one saved run. The record with the lowest artifact_sha256 is used; the collision is surfaced for human investigation."
        }
      }
    },
    "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } },
    "candidate": {
      "oneOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }]
    }
  }
}
