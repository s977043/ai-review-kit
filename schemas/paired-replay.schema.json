{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Evolution Cycle Paired Replay Schema",
  "description": "Read-only paired replay artifact (#1574 P2). Emitted by `river evolve replay`. Pins the experiment conditions into an immutable Experiment Manifest (contract 3), pairs baseline and candidate findings by fingerprint, and reports the delta against the declared per-profile acceptance criteria (contract 6). It never re-runs a review and never decides adoption: `acceptance.decision` is always null and `writeEffects` is always empty. Contracts: docs/development/1574-p0-design-contract.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "mode",
    "readOnly",
    "policyVersion",
    "collectorVersion",
    "manifest",
    "manifestVerification",
    "pairing",
    "metrics",
    "activationCheck",
    "acceptance",
    "verification",
    "terminalReason",
    "requiresHumanApproval",
    "autoActions",
    "writeEffects"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runEvidence": {
      "type": "object",
      "description": "Contract 1 provenance record for one saved run, produced by the P1 builder (src/lib/shadow-aggregate.mjs). Every field is self-reported by the reviewed repository and unverified. DRIFT WATCH: this $defs block and the identically named one in schemas/shadow-aggregate.schema.json describe the output of the SAME producer (buildRunEvidence). Cross-file $ref is unavailable (neither schema declares an $id), so a change to one MUST be applied to the other in the same PR.",
      "required": [
        "review_run_id",
        "evidence_source",
        "source_commit_sha",
        "artifact_sha256",
        "collector_version",
        "trusted_by",
        "generated_by_candidate",
        "provenance_verified",
        "trust_level"
      ],
      "additionalProperties": false,
      "properties": {
        "review_run_id": { "type": ["string", "null"] },
        "evidence_source": {
          "type": "string",
          "enum": ["local", "CI", "protected-branch", "human"]
        },
        "source_commit_sha": { "type": ["string", "null"] },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "collector_version": { "type": "string" },
        "trusted_by": { "type": ["string", "null"] },
        "generated_by_candidate": { "type": "boolean" },
        "provenance_verified": { "type": "boolean", "const": false },
        "trust_level": {
          "type": "string",
          "const": "untrusted",
          "description": "P2 keeps P1's classification: the verification mechanism for `trusted_by` is still a contract 1 未決事項, so no evidence path reaches `trusted`."
        }
      }
    },
    "side": {
      "type": "object",
      "description": "One configuration under comparison (baseline or candidate), as pinned by the manifest.",
      "required": [
        "commitSha",
        "skillRegistryCommit",
        "provider",
        "model",
        "temperature",
        "configId",
        "runCount",
        "reviewRunIds",
        "caseKeys",
        "unkeyedRunCount",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "commitSha": { "type": "string" },
        "skillRegistryCommit": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "temperature": { "type": ["number", "null"] },
        "configId": { "type": ["string", "null"] },
        "runCount": { "type": "integer", "minimum": 1 },
        "reviewRunIds": { "type": "array", "items": { "type": "string" } },
        "caseKeys": { "type": "array", "items": { "type": "string" } },
        "unkeyedRunCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Runs whose case key could not be derived. They are never paired — pairing them by position would compare unrelated reviews."
        },
        "provenance": {
          "type": "object",
          "description": "Summary DERIVED from this side's own run evidence — never from the declaration (#1719). `sourceCommitSha` is the reviewed repository's HEAD as reported by the runs, a different namespace from the sibling `commitSha`, which is a configuration identifier that baseline and candidate are expected to differ on. OPTIONAL: manifests created before this field existed stay valid under the same schemaVersion. Adding the block does change the digest VALUES of newly built manifests, but not their determinism — every count comes from the same run records that already feed artifact_sha256, so identical records still produce an identical experimentKey.",
          "required": [
            "sourceCommitSha",
            "sourceCommitShaUnknownRunCount",
            "dirtyRunCount",
            "dirtyUnknownRunCount"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceCommitSha": {
              "type": ["string", "null"],
              "description": "The single reviewed commit this side's runs agree on, lowercased (an abbreviated sha resolves to the longest form it prefixes). Null when the runs report none, or when the side legitimately spans several commits — a dataset whose cases were collected at different times. Runs of the SAME case that disagree are refused at build time instead."
            },
            "sourceCommitShaUnknownRunCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Runs with no source_commit_sha (records written before #1715). Treated as 未取得, not as a contradiction — but the consistency check is vacuous for them, so the count is surfaced as an activation reason."
            },
            "dirtyRunCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Runs collected from a dirty working tree (#1718). Their source_commit_sha is the HEAD the review sat on top of, so it can agree with its neighbours while the reviewed lines exist only in the working tree."
            },
            "dirtyUnknownRunCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Runs that recorded no dirty flag. Counted apart from the observed-clean ones so unknown never reads as clean."
            }
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/runEvidence" } }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["metric", "comparator", "threshold", "required", "source"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "comparator": { "type": "string", "enum": ["lte", "lt", "gte", "gt", "eq"] },
        "threshold": { "type": "number" },
        "required": { "type": "boolean" },
        "source": {
          "type": "string",
          "enum": ["declared", "contract-6"],
          "description": "`contract-6` marks the mandatory critical-regression-0 criterion injected into every profile that did not declare it."
        }
      }
    },
    "evaluatedCriterion": {
      "type": "object",
      "required": [
        "metric",
        "comparator",
        "threshold",
        "required",
        "source",
        "observed",
        "evaluable",
        "satisfied",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "comparator": { "type": "string", "enum": ["lte", "lt", "gte", "gt", "eq"] },
        "threshold": { "type": "number" },
        "required": { "type": "boolean" },
        "source": { "type": "string", "enum": ["declared", "contract-6"] },
        "observed": { "type": ["number", "null"] },
        "evaluable": {
          "type": "boolean",
          "description": "False when the metric cannot be observed from paired replay inputs (precision / recall / cost / reversal need labelled outcomes)."
        },
        "satisfied": {
          "type": ["boolean", "null"],
          "description": "null when the metric is not evaluable — never silently treated as satisfied."
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "profile": {
      "type": "object",
      "required": ["profile", "minSampleSize", "criteria"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string" },
        "minSampleSize": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Declared minimum sample size. null means undeclared and is reported as null, never as satisfied: 「代表10件」は smoke test の最低条件であり統計的十分性ではない (contract 6)."
        },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } }
      }
    },
    "findingProjection": {
      "type": "object",
      "required": ["fingerprint", "severity", "file", "ruleId", "title"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "severity": { "type": "string", "enum": ["critical", "major", "minor", "info"] },
        "file": { "type": ["string", "null"] },
        "ruleId": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] }
      }
    },
    "pair": {
      "type": "object",
      "required": ["fingerprint", "status", "baseline", "candidate", "severityChange"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "status": {
          "type": "string",
          "enum": ["unchanged", "changed", "removed", "added"],
          "description": "`changed` compares severity only: reviewer wording differs between runs and would report noise as signal."
        },
        "baseline": {
          "oneOf": [{ "$ref": "#/$defs/findingProjection" }, { "type": "null" }]
        },
        "candidate": {
          "oneOf": [{ "$ref": "#/$defs/findingProjection" }, { "type": "null" }]
        },
        "severityChange": {
          "oneOf": [
            {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "unchanged",
        "changed",
        "removed",
        "added",
        "unpairableBaseline",
        "unpairableCandidate",
        "duplicatesRemovedBaseline",
        "duplicatesRemovedCandidate",
        "severityConflictsBaseline",
        "severityConflictsCandidate"
      ],
      "additionalProperties": false,
      "properties": {
        "unchanged": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "added": { "type": "integer", "minimum": 0 },
        "unpairableBaseline": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings with no fingerprint: they cannot be matched, and matching them by file/title would invent a correspondence."
        },
        "unpairableCandidate": { "type": "integer", "minimum": 0 },
        "duplicatesRemovedBaseline": { "type": "integer", "minimum": 0 },
        "duplicatesRemovedCandidate": { "type": "integer", "minimum": 0 },
        "severityConflictsBaseline": {
          "type": "integer",
          "minimum": 0,
          "description": "Duplicate fingerprints on this side that disagreed on severity. The collapse keeps the HIGHEST severity (fail-safe), so a `minor` duplicate can never hide a `critical` regression."
        },
        "severityConflictsCandidate": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "sampleSize",
        "unchangedFindingCount",
        "changedFindingCount",
        "removedFindingCount",
        "addedFindingCount",
        "criticalRegressionCount",
        "criticalAdditionCount",
        "unpairableFindingCount",
        "pairedCaseCount",
        "datasetCaseCount",
        "unpairedCaseCount",
        "denominator"
      ],
      "additionalProperties": false,
      "properties": {
        "sampleSize": { "type": "integer", "minimum": 0 },
        "unchangedFindingCount": { "type": "integer", "minimum": 0 },
        "changedFindingCount": { "type": "integer", "minimum": 0 },
        "removedFindingCount": { "type": "integer", "minimum": 0 },
        "addedFindingCount": { "type": "integer", "minimum": 0 },
        "criticalRegressionCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Critical baseline findings the candidate lost or downgraded. Contract 6 requires 0; P2 reports the number and never applies it as a gate."
        },
        "criticalAdditionCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Critical findings the candidate added or upgraded. Counted separately from regressions because only a human can tell a genuine catch from a new false positive."
        },
        "unpairableFindingCount": { "type": "integer", "minimum": 0 },
        "pairedCaseCount": { "type": "integer", "minimum": 0 },
        "datasetCaseCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Cases the manifest pinned. Dataset-wide, identical in every scope."
        },
        "unpairedCaseCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Dataset cases that could not be compared because one side is missing. Dataset-wide: a hole in the material regardless of which subset acceptance is judged on."
        },
        "denominator": {
          "type": "string",
          "enum": ["paired-finding", "paired-case"],
          "description": "Unit `sampleSize` is counted in. A closed vocabulary because the aggregation actually switches on it: 'at least 3' must not mean findings while the reader declared cases."
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "const": "paired-replay" },
    "readOnly": { "type": "boolean", "const": true },
    "policyVersion": { "type": "string" },
    "collectorVersion": { "type": "string" },
    "manifest": {
      "type": "object",
      "description": "Immutable Experiment Manifest (contract 3). `experimentKey` hashes the experiment conditions only, so the same conditions always produce the same manifestId; `manifestHash` additionally covers createdAt and the derived ids, so any edit to the stored document is detectable.",
      "required": [
        "manifestId",
        "experimentKey",
        "manifestHash",
        "createdAt",
        "schemaVersion",
        "kind",
        "policyVersion",
        "hypothesis",
        "improvementCandidate",
        "baseline",
        "candidate",
        "dataset",
        "evaluator",
        "trials",
        "verifier",
        "activation",
        "environment",
        "metrics",
        "terminalReasonVocabulary",
        "acceptance",
        "writeEffects"
      ],
      "additionalProperties": false,
      "properties": {
        "manifestId": { "type": "string", "pattern": "^RR-EXP-[0-9a-f]{12}$" },
        "experimentKey": { "$ref": "#/$defs/sha256" },
        "manifestHash": { "$ref": "#/$defs/sha256" },
        "createdAt": { "type": "string", "format": "date-time" },
        "schemaVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "experiment-manifest" },
        "policyVersion": { "type": "string" },
        "hypothesis": { "type": ["string", "null"] },
        "improvementCandidate": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "candidateId",
                "contentHash",
                "uniqueEvidenceCount",
                "clusterKey",
                "policyVersion",
                "hypothesis"
              ],
              "additionalProperties": false,
              "properties": {
                "candidateId": {
                  "type": "string",
                  "pattern": "^RR-PC-[0-9a-f]{12}$",
                  "description": "Content-addressed candidate id from src/lib/promotion-candidates.mjs (contract 4), reused via the P1 adapter so the experiment refers to the same candidate the shadow aggregate observed and `river promote propose` persists."
                },
                "contentHash": { "$ref": "#/$defs/sha256" },
                "uniqueEvidenceCount": { "type": "integer", "minimum": 1 },
                "clusterKey": { "type": "string" },
                "policyVersion": { "type": "string" },
                "hypothesis": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "baseline": { "$ref": "#/$defs/side" },
        "candidate": { "$ref": "#/$defs/side" },
        "dataset": {
          "type": "object",
          "required": ["caseKeys", "caseCount", "datasetHash", "heldOutCaseKeys", "heldOutHash"],
          "additionalProperties": false,
          "properties": {
            "caseKeys": { "type": "array", "items": { "type": "string" } },
            "caseCount": { "type": "integer", "minimum": 0 },
            "datasetHash": { "$ref": "#/$defs/sha256" },
            "heldOutCaseKeys": { "type": "array", "items": { "type": "string" } },
            "heldOutHash": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            }
          }
        },
        "evaluator": {
          "type": "object",
          "required": ["evaluatorVersion", "collectorVersion"],
          "additionalProperties": false,
          "properties": {
            "evaluatorVersion": { "type": "string" },
            "collectorVersion": { "type": "string" }
          }
        },
        "trials": {
          "type": "object",
          "required": ["trialId", "trialCount"],
          "additionalProperties": false,
          "properties": {
            "trialId": { "type": ["string", "null"] },
            "trialCount": { "type": "integer", "minimum": 1 }
          }
        },
        "verifier": {
          "type": "object",
          "required": ["independent", "verifierId", "runBy"],
          "additionalProperties": false,
          "properties": {
            "independent": {
              "type": "boolean",
              "description": "CLAIMED only. P2 has no attestation mechanism, so verification.independentVerifierVerified stays false."
            },
            "verifierId": { "type": ["string", "null"] },
            "runBy": { "type": ["string", "null"] }
          }
        },
        "activation": {
          "type": "object",
          "required": ["expectedSignal", "declaredEvidence"],
          "additionalProperties": false,
          "properties": {
            "expectedSignal": { "type": ["string", "null"] },
            "declaredEvidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "environment": { "type": "object" },
        "metrics": {
          "type": "object",
          "required": ["denominator"],
          "additionalProperties": false,
          "properties": {
            "denominator": { "type": "string", "enum": ["paired-finding", "paired-case"] }
          }
        },
        "terminalReasonVocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "budget_exhausted",
              "no_progress",
              "oscillation",
              "verifier_unavailable",
              "human_escalated"
            ]
          },
          "description": "The manifest pins the VOCABULARY (an experiment condition); the observed value lives on the result, because writing an outcome back into the manifest would break its immutability."
        },
        "acceptance": {
          "type": "object",
          "required": ["profiles"],
          "additionalProperties": false,
          "properties": {
            "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } }
          }
        },
        "writeEffects": { "type": "array", "maxItems": 0 }
      }
    },
    "manifestVerification": {
      "type": "object",
      "required": [
        "verified",
        "mismatches",
        "experimentKeyMatchesInputs",
        "recomputedExperimentKey"
      ],
      "additionalProperties": false,
      "properties": {
        "verified": { "type": "boolean" },
        "mismatches": { "type": "array", "items": { "type": "string" } },
        "experimentKeyMatchesInputs": {
          "type": "boolean",
          "description": "False when a supplied manifest describes different conditions than the inputs of this run — comparing under a stale manifest would misattribute the difference."
        },
        "recomputedExperimentKey": { "$ref": "#/$defs/sha256" }
      }
    },
    "pairing": {
      "type": "object",
      "required": [
        "cases",
        "datasetCaseCount",
        "pairedCaseCount",
        "unpairedCases",
        "unkeyedRunCount",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "caseKey",
              "heldOut",
              "baselineRunIds",
              "candidateRunIds",
              "counts",
              "criticalRegressions",
              "criticalAdditions",
              "findings",
              "unpairable"
            ],
            "additionalProperties": false,
            "properties": {
              "caseKey": { "type": "string" },
              "heldOut": { "type": "boolean" },
              "baselineRunIds": { "type": "array", "items": { "type": "string" } },
              "candidateRunIds": { "type": "array", "items": { "type": "string" } },
              "counts": { "$ref": "#/$defs/counts" },
              "criticalRegressions": { "type": "array", "items": { "type": "string" } },
              "criticalAdditions": { "type": "array", "items": { "type": "string" } },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
              "unpairable": {
                "type": "object",
                "required": ["baseline", "candidate"],
                "additionalProperties": false,
                "properties": {
                  "baseline": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/findingProjection" }
                  },
                  "candidate": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/findingProjection" }
                  }
                }
              }
            }
          }
        },
        "datasetCaseCount": { "type": "integer", "minimum": 0 },
        "pairedCaseCount": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Gaps in the material a human must see before reading the diff as a claim about the dataset (cases dropped because one side is missing, runs without a case key, an unevaluable acceptance scope)."
        },
        "unpairedCases": {
          "type": "object",
          "required": ["baselineOnly", "candidateOnly"],
          "additionalProperties": false,
          "properties": {
            "baselineOnly": { "type": "array", "items": { "type": "string" } },
            "candidateOnly": { "type": "array", "items": { "type": "string" } }
          }
        },
        "unkeyedRunCount": {
          "type": "object",
          "required": ["baseline", "candidate"],
          "additionalProperties": false,
          "properties": {
            "baseline": { "type": "integer", "minimum": 0 },
            "candidate": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["overall", "heldOut"],
      "additionalProperties": false,
      "properties": {
        "overall": { "$ref": "#/$defs/metrics" },
        "heldOut": {
          "oneOf": [{ "$ref": "#/$defs/metrics" }, { "type": "null" }],
          "description": "null when no held-out case set was declared."
        }
      }
    },
    "activationCheck": {
      "type": "object",
      "description": "DoD 4 activation: did the candidate configuration actually differ, and did that difference reach the output? A replay whose configuration is identical is reported as not activated, so a 'no regression' result is not misread as evidence about the candidate.",
      "required": [
        "configurationDiffers",
        "observedDifference",
        "verified",
        "expectedSignal",
        "declaredEvidence",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "configurationDiffers": { "type": "boolean" },
        "observedDifference": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "sourceCommitShaCoverage": {
          "type": "object",
          "description": "How many runs across BOTH sides can name the code they reviewed (#1719). Reported, never folded into `verified`: naming the reviewed code is a different question from whether the configuration differed. OPTIONAL so results produced before this field existed stay valid under the same schemaVersion. Per-side counts live on manifest.<side>.provenance.",
          "required": ["runCount", "knownRunCount", "unknownRunCount"],
          "additionalProperties": false,
          "properties": {
            "runCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Denominator: runs of both sides combined."
            },
            "knownRunCount": { "type": "integer", "minimum": 0 },
            "unknownRunCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Runs reporting no source_commit_sha. Non-zero always adds an activation reason, so the gap is never silent."
            }
          }
        },
        "crossSideSourceCommitSha": {
          "type": "object",
          "description": "Whether baseline and candidate derived DIFFERENT reviewed commits (#1724). #1719 checks each side against itself only, so a side re-collected at another commit passes it. Reported, never refused: re-collecting one side later is a legitimate way to run an experiment. OPTIONAL so results produced before this field existed stay valid under the same schemaVersion.",
          "required": ["baseline", "candidate", "comparable", "differs"],
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "type": ["string", "null"],
              "description": "manifest.baseline.provenance.sourceCommitSha, already lowercased and prefix-resolved. null when the side reports none or spans several commits."
            },
            "candidate": { "type": ["string", "null"] },
            "comparable": {
              "type": "boolean",
              "description": "Both sides derived a sha, so the comparison could be made."
            },
            "differs": {
              "type": ["boolean", "null"],
              "description": "null (not false) when comparable is false: 未取得 is not agreement. true adds an activation reason, so the gap is never silent."
            }
          }
        },
        "expectedSignal": { "type": ["string", "null"] },
        "declaredEvidence": { "type": "array", "items": { "type": "string" } },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance": {
      "type": "object",
      "description": "Contract 6 evaluation. Reports observation against the declared criteria and NEVER derives adoption: decision is const null, applied and autoPromotion const false.",
      "required": [
        "declaredProfileCount",
        "evaluatedOn",
        "evaluable",
        "evaluations",
        "contract6",
        "decision",
        "applied",
        "autoPromotion",
        "requiresHumanJudgment",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "declaredProfileCount": { "type": "integer", "minimum": 0 },
        "evaluatedOn": {
          "type": "string",
          "enum": ["heldOut", "overall"],
          "description": "Acceptance is judged on the held-out set when one is declared: evaluating on the cases the candidate was derived from would be self-confirming."
        },
        "evaluable": {
          "type": "boolean",
          "description": "False when the evaluated scope contains no paired case. Every criterion is then reported unobserved (satisfied: null) instead of trivially satisfied on an empty set."
        },
        "evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile",
              "evaluatedOn",
              "sampleSize",
              "minSampleSize",
              "sampleSizeSatisfied",
              "criteria",
              "criteriaMet",
              "criteriaFailed",
              "criteriaUnevaluable",
              "allRequiredSatisfied",
              "failedMetrics"
            ],
            "additionalProperties": false,
            "properties": {
              "profile": { "type": "string" },
              "evaluatedOn": { "type": "string", "enum": ["heldOut", "overall"] },
              "sampleSize": { "type": "integer", "minimum": 0 },
              "minSampleSize": { "type": ["integer", "null"], "minimum": 0 },
              "sampleSizeSatisfied": { "type": ["boolean", "null"] },
              "criteria": { "type": "array", "items": { "$ref": "#/$defs/evaluatedCriterion" } },
              "criteriaMet": { "type": "integer", "minimum": 0 },
              "criteriaFailed": { "type": "integer", "minimum": 0 },
              "criteriaUnevaluable": { "type": "integer", "minimum": 0 },
              "allRequiredSatisfied": {
                "type": "boolean",
                "description": "Observation only: 'every required criterion was observable and met'. Not a verdict — the decision field stays null regardless."
              },
              "failedMetrics": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "contract6": {
          "type": "object",
          "required": [
            "criticalRegressionCount",
            "criticalRegressionZero",
            "overallCriticalRegressionCount",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "criticalRegressionCount": {
              "type": ["integer", "null"],
              "minimum": 0,
              "description": "Observed on the evaluated scope, or null when that scope has no paired case (no evidence either way)."
            },
            "criticalRegressionZero": { "type": ["boolean", "null"] },
            "overallCriticalRegressionCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Always reported over every paired case, so a held-out scope cannot hide a regression seen elsewhere in the dataset."
            },
            "note": { "type": "string" }
          }
        },
        "decision": {
          "type": "null",
          "description": "Machine-checkable non-goal: P2 produces material for a human judgement, never a verdict. Automatic canary / Keep / Rollback are 保留 per the #1574 採否コメント."
        },
        "applied": { "type": "boolean", "const": false },
        "autoPromotion": { "type": "boolean", "const": false },
        "requiresHumanJudgment": { "type": "boolean", "const": true },
        "note": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "independentVerifierClaimed",
        "independentVerifierVerified",
        "trustedEvidenceCount",
        "untrustedEvidenceCount",
        "canaryEligible",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "independentVerifierClaimed": { "type": "boolean" },
        "independentVerifierVerified": {
          "type": "boolean",
          "const": false,
          "description": "Always false: the attestation mechanism for `trusted_by` is still a contract 1 未決事項 after P2."
        },
        "trustedEvidenceCount": { "type": "integer", "const": 0 },
        "untrustedEvidenceCount": { "type": "integer", "minimum": 0 },
        "canaryEligible": { "type": "boolean", "const": false },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "terminalReason": {
      "type": "string",
      "enum": ["success", "no_progress"],
      "description": "P2 can only end in `success` (the replay compared at least one case) or `no_progress` (no case could be paired). The other vocabulary entries belong to the loop-driving phases."
    },
    "requiresHumanApproval": { "type": "boolean", "const": true },
    "autoActions": { "type": "array", "items": { "type": "string", "enum": ["observe"] } },
    "writeEffects": {
      "type": "array",
      "maxItems": 0,
      "description": "Machine-checkable assertion that the paired replay performs no writes."
    }
  }
}
