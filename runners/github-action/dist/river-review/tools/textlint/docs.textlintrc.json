{
  // docs/** と README*.md に適用する緩和 config（pages/** は既定の .textlintrc.json を使う）。
  // 最終形は pages/** と同じフルルールであり、到達した時点でこのファイルは .textlintrc.json へ
  // 統合されて消える。移行の段階定義は Issue #1786 を参照。
  //
  // 下の `false` は 2 種類ある。区別できるようにセクション見出しを付けている。
  //   - 恒久無効: 既定の .textlintrc.json でも `false`。段階移行が完了しても有効化しない
  //   - 一時無効: 既定の .textlintrc.json では有効。段階移行の各段で順次有効化する
  // あわせて、既定 config にある `prh`（用語辞書）はこのファイルに定義自体が無く、docs/** と
  // README*.md では発火しない。これも一時的な差であり、段階移行の最終段で取り込む。
  "plugins": {},
  "filters": {},
  "rules": {
    "preset-ja-technical-writing": {
      "max-ten": {
        "max": 3
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [":", "→", "…"]
      },
      "no-exclamation-question-mark": {
        "allowFullWidthExclamation": true,
        "allowFullWidthQuestion": true
      },

      // --- 恒久無効（既定 config でも false。段階移行の対象外） ---
      "ja-no-redundant-expression": false,

      // --- 一時無効（段階 2 で順次有効化する。既定 config では有効） ---
      // sentence-length は有効化時の閾値を既定 config と同じ max 150 にする（preset 既定の 100 ではない）
      "sentence-length": false,
      "no-mix-dearu-desumasu": false,
      "no-doubled-joshi": false
    }
  }
}
