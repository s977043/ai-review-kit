{
  // docs/** と README*.md に適用する緩和 config（pages/** は既定の .textlintrc.json を使う）。
  // 最終形は pages/** と同じフルルールであり、到達した時点でこのファイルは .textlintrc.json へ
  // 統合されて消える。移行の段階定義は Issue #1786 を参照。
  //
  // 下の `false` は 2 種類ある。区別できるようにセクション見出しを付けている。
  //   - 恒久無効: 既定の .textlintrc.json でも `false`。段階移行が完了しても有効化しない
  //   - 一時無効: 既定の .textlintrc.json では有効。段階移行の各段で順次有効化する
  // `prh`（用語辞書）は段階 2-a で有効化済み（#1786）。既定 config と同じ tools/prh-rules/index.yml を
  // 共有する。有効化にあたり index.yml のパターンを語境界厳格化（ハイフン・アンダースコア・ドットを
  // 境界として扱う）しており、識別子・URL スラッグ内の部分一致を誤検出しない（canary は
  // tests/prh-rules-canary.test.mjs 参照）。
  "plugins": {},
  "filters": {},
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "max-ten": {
        "max": 3
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [":", "→", "…"]
      },
      "no-exclamation-question-mark": {
        "allowFullWidthExclamation": true,
        "allowFullWidthQuestion": true
      },

      // --- 恒久無効（既定 config でも false。段階移行の対象外） ---
      "ja-no-redundant-expression": false,

      // --- 一時無効（段階 2 で順次有効化する。既定 config では有効） ---
      "no-mix-dearu-desumasu": false
      // no-doubled-joshi は段階 2-b で有効化済み（#1786）。retrospectives は .textlintignore で除外している。
      // sentence-length は段階 2-c で有効化済み（#1786、上の設定を参照）。既定 config と同じ閾値 max 150（preset 既定の 100 ではない）。
    },
    "prh": {
      "rulePaths": ["../prh-rules/index.yml"]
    }
  }
}
